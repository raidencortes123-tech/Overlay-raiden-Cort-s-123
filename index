<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stream Overlays Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ruined: {
                            cyan: '#00ffcc',
                            mint: '#3affcf',
                            dark: '#081212',
                            glow: 'rgba(0, 255, 204, 0.25)'
                        }
                    },
                    fontFamily: {
                        cinzel: ['Cinzel', 'serif'],
                        rajdhani: ['Rajdhani', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #040909;
            background-image: radial-gradient(circle at 50% 20%, rgba(0, 255, 204, 0.08) 0%, transparent 60%);
            font-family: 'Rajdhani', sans-serif;
            color: #e2fdf8;
        }

        .glass-panel {
            background: rgba(6, 15, 15, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 255, 204, 0.35);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.65), inset 0 0 12px rgba(0, 255, 204, 0.1);
            transition: all 0.3s ease;
        }

        .glass-panel:hover {
            border-color: rgba(0, 255, 204, 0.8);
            box-shadow: 0 12px 40px 0 rgba(0, 255, 204, 0.25), inset 0 0 20px rgba(0, 255, 204, 0.2);
            transform: translateY(-3px);
        }

        .corner-ornament {
            position: absolute;
            width: 10px;
            height: 10px;
            border-color: #00ffcc;
            pointer-events: none;
            filter: drop-shadow(0 0 3px #00ffcc);
        }
        .corner-tl { top: -2px; left: -2px; border-top: 2px solid; border-left: 2px solid; }
        .corner-tr { top: -2px; right: -2px; border-top: 2px solid; border-right: 2px solid; }
        .corner-bl { bottom: -2px; left: -2px; border-bottom: 2px solid; border-left: 2px solid; }
        .corner-br { bottom: -2px; right: -2px; border-bottom: 2px solid; border-right: 2px solid; }

        .glow-text {
            text-shadow: 0 0 10px rgba(0, 255, 204, 0.7);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between items-center p-6">

    <!-- CABECERA -->
    <header class="w-full max-w-4xl my-8 text-center">
        <div class="glass-panel py-6 px-8 rounded-2xl relative inline-block w-full">
            <div class="corner-ornament corner-tl"></div>
            <div class="corner-ornament corner-tr"></div>
            <div class="corner-ornament corner-bl"></div>
            <div class="corner-ornament corner-br"></div>
            
            <div class="flex items-center justify-center gap-3 mb-2">
                <i class="fa-solid fa-dragon text-ruined-cyan text-3xl"></i>
                <h1 class="font-cinzel text-3xl md:text-4xl font-bold tracking-widest text-white glow-text">
                    OVERLAYS DASHBOARD
                </h1>
            </div>
            <p class="text-ruined-cyan/80 text-sm md:text-base font-bold tracking-wider uppercase">
                Panel de Navegación de Recursos OBS / Aitum
            </p>
        </div>
    </header>

    <!-- CONTENEDOR DE TARJETAS / ENLACES -->
    <main class="w-full max-w-4xl grid grid-cols-1 md:grid-cols-2 gap-6 my-auto">

        <!-- 1. Overlay Chat 1 -->
        <a href="Overlay%20chat%201.html" class="glass-panel p-6 rounded-2xl relative group flex flex-col justify-between">
            <div class="corner-ornament corner-tl"></div>
            <div class="corner-ornament corner-tr"></div>
            <div class="corner-ornament corner-bl"></div>
            <div class="corner-ornament corner-br"></div>

            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                    <div class="p-3 bg-ruined-cyan/10 rounded-xl border border-ruined-cyan/30 group-hover:bg-ruined-cyan/20 transition-colors">
                        <i class="fa-solid fa-comments text-ruined-cyan text-2xl"></i>
                    </div>
                    <div>
                        <h2 class="font-cinzel text-xl font-bold text-white group-hover:text-ruined-cyan transition-colors">
                            Overlay Chat 1
                        </h2>
                        <span class="text-xs text-gray-400 font-mono">Overlay chat 1.html</span>
                    </div>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square text-ruined-cyan/50 group-hover:text-ruined-cyan group-hover:translate-x-1 group-hover:-translate-y-1 transition-all"></i>
            </div>
            <p class="text-sm text-gray-300">Modulo individual para visualización del chat en pantalla.</p>
        </a>

        <!-- 2. Overlay Principal -->
        <a href="Overlay%20principal.html" class="glass-panel p-6 rounded-2xl relative group flex flex-col justify-between">
            <div class="corner-ornament corner-tl"></div>
            <div class="corner-ornament corner-tr"></div>
            <div class="corner-ornament corner-bl"></div>
            <div class="corner-ornament corner-br"></div>

            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                    <div class="p-3 bg-ruined-cyan/10 rounded-xl border border-ruined-cyan/30 group-hover:bg-ruined-cyan/20 transition-colors">
                        <i class="fa-solid fa-desktop text-ruined-cyan text-2xl"></i>
                    </div>
                    <div>
                        <h2 class="font-cinzel text-xl font-bold text-white group-hover:text-ruined-cyan transition-colors">
                            Overlay Principal
                        </h2>
                        <span class="text-xs text-gray-400 font-mono">Overlay principal.html</span>
                    </div>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square text-ruined-cyan/50 group-hover:text-ruined-cyan group-hover:translate-x-1 group-hover:-translate-y-1 transition-all"></i>
            </div>
            <p class="text-sm text-gray-300">Plantilla horizontal estándar (1920x1080) para transmisión de PC.</p>
        </a>

        <!-- 3. Vertical Overlay (Con espacios) -->
        <a href="vertical%20overlay.html" class="glass-panel p-6 rounded-2xl relative group flex flex-col justify-between">
            <div class="corner-ornament corner-tl"></div>
            <div class="corner-ornament corner-tr"></div>
            <div class="corner-ornament corner-bl"></div>
            <div class="corner-ornament corner-br"></div>

            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                    <div class="p-3 bg-ruined-cyan/10 rounded-xl border border-ruined-cyan/30 group-hover:bg-ruined-cyan/20 transition-colors">
                        <i class="fa-solid fa-mobile-screen-button text-ruined-cyan text-2xl"></i>
                    </div>
                    <div>
                        <h2 class="font-cinzel text-xl font-bold text-white group-hover:text-ruined-cyan transition-colors">
                            Vertical Overlay (Alt 1)
                        </h2>
                        <span class="text-xs text-gray-400 font-mono">vertical overlay.html</span>
                    </div>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square text-ruined-cyan/50 group-hover:text-ruined-cyan group-hover:translate-x-1 group-hover:-translate-y-1 transition-all"></i>
            </div>
            <p class="text-sm text-gray-300">Versión vertical (1080x1920) para Aitum / TikTok / Shorts.</p>
        </a>

        <!-- 4. Vertical Overlay (Con guion bajo) -->
        <a href="vertical_overlay.html" class="glass-panel p-6 rounded-2xl relative group flex flex-col justify-between">
            <div class="corner-ornament corner-tl"></div>
            <div class="corner-ornament corner-tr"></div>
            <div class="corner-ornament corner-bl"></div>
            <div class="corner-ornament corner-br"></div>

            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                    <div class="p-3 bg-ruined-cyan/10 rounded-xl border border-ruined-cyan/30 group-hover:bg-ruined-cyan/20 transition-colors">
                        <i class="fa-solid fa-mobile-screen text-ruined-cyan text-2xl"></i>
                    </div>
                    <div>
                        <h2 class="font-cinzel text-xl font-bold text-white group-hover:text-ruined-cyan transition-colors">
                            Vertical Overlay (Alt 2)
                        </h2>
                        <span class="text-xs text-gray-400 font-mono">vertical_overlay.html</span>
                    </div>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square text-ruined-cyan/50 group-hover:text-ruined-cyan group-hover:translate-x-1 group-hover:-translate-y-1 transition-all"></i>
            </div>
            <p class="text-sm text-gray-300">Versión vertical optimizada con guion bajo en el nombre del archivo.</p>
        </a>

    </main>

    <!-- PIE DE PÁGINA -->
    <footer class="w-full max-w-4xl my-6 text-center">
        <div class="glass-panel py-3 px-6 rounded-xl relative inline-flex items-center justify-center gap-2 text-sm text-gray-300">
            <div class="corner-ornament corner-tl"></div>
            <div class="corner-ornament corner-tr"></div>
            <div class="corner-ornament corner-bl"></div>
            <div class="corner-ornament corner-br"></div>
            <i class="fa-solid fa-code text-ruined-cyan"></i>
            <span>GitHub Pages Hub — </span>
            <span class="text-ruined-cyan font-bold">@RAIDENCORTES123</span>
        </div>
    </footer>

</body>
</html>
